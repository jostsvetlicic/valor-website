# VALOR — environment variables.
# Copy this file to `.env.local` and fill in real values. Never commit secrets.

# Google Business Profile reviews page — the "read all reviews" link on the
# References section. Leave BLANK until the profile exists; the link is hidden
# while empty. Do NOT invent a URL.
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=

# Aggregate rating shown on the References section, sourced from the real
# Google Business Profile. Both must be set for the rating to appear; leave
# blank otherwise. Do NOT invent numbers.
NEXT_PUBLIC_GOOGLE_RATING=
NEXT_PUBLIC_GOOGLE_REVIEW_COUNT=
